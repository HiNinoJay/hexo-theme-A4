<% if(theme.imageShow.enable) { %>
    <!-- 预加载背景图片：让浏览器在解析 CSS 的同时就开始下载图片，避免背景图加载完成前先显示纯色再跳变造成的闪烁 -->
    <link rel="preload" as="image" href="<%= theme.imageShow.background %>" fetchpriority="high" />
    <style>
        body {
            background-image: url(<%= theme.imageShow.background %>);
            background-attachment: fixed;  /* 背景固定，不随页面滚动 */
            background-repeat: no-repeat;  /* 防止背景图片重复 */
            background-size: cover;       /* 背景自适应大小，覆盖整个背景 */
            background-position: center;   /* 背景居中显示 */
        }
        .paper {
            background-image: url(<%= theme.imageShow.background %>);
            background-attachment: fixed;  /* 背景固定，不随页面滚动 */
            background-repeat: no-repeat;  /* 防止背景图片重复 */
            background-size: cover;       /* 背景自适应大小，覆盖整个背景 */
            background-position: center;   /* 背景居中显示 */
        }  
    </style>
<% } %>
