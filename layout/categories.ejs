<br>
<span><span class="darkmode-ignore">🔖</span><i>categories</i></span>
<ul class="" >
  <% class HashMap {
    constructor() {
      this.map = {};
    }
  
    put(key, value) {
      this.map[key] = value;
    }
  
    get(key) {
      return this.map[key];
    }
  
    containsKey(key) {
      return key in this.map;
    }
  
    remove(key) {
      delete this.map[key];
    }
  
    size() {
      return Object.keys(this.map).length;
    }
  
    isEmpty() {
      return this.size() === 0;
    }
  
    clear() {
      this.map = {};
    }
  }
  %>

  <% class List {
    constructor() {
      this.items = [];
    }
  
    add(item) {
      this.items.push(item);
    }
  
    remove(item) {
      const index = this.items.indexOf(item);
      if (index > -1) {
        this.items.splice(index, 1);
      }
    }
  
    get(index) {
      return this.items[index];
    }
  
    size() {
      return this.items.length;
    }
  }
   %>

  <% var array = eval('site.posts.data') %>

  <% var categoriesHashMap = new HashMap() %>
  <% var categoryChildHashmap = new HashMap() %>
  <% var childCountMap = new HashMap() %>
  <% var categoriesList = new List() %>
  
  <% for(var i = 0; i < array.length; i++) {
     if(!('hide' in array[i]) || array[i].hide == false){

        var postCategories = array[i].categories.data;
        for(var j = 0; j < postCategories.length; j++) {

          if(postCategories.length > 1) {
            var childCat = postCategories[1];
            var parentName = postCategories[0].name;
            // 记录父分类下的子分类（去重），用于二级分类展示
            if(!categoryChildHashmap.containsKey(parentName)) {
              categoryChildHashmap.put(parentName, new List());
            }
            var childListOfParent = categoryChildHashmap.get(parentName);
            var childExists = false;
            for(var k = 0; k < childListOfParent.size(); k++) {
              if(childListOfParent.get(k).name == childCat.name) { childExists = true; break; }
            }
            if(!childExists) { childListOfParent.add(childCat); }
            // 子分类文章计数
            if(!childCountMap.containsKey(childCat.name)) {
              childCountMap.put(childCat.name, 1);
            } else {
              childCountMap.put(childCat.name, childCountMap.get(childCat.name) + 1);
            }
          }

          if(!categoriesHashMap.containsKey(postCategories[j].name)) {
            categoriesHashMap.put(postCategories[j].name, 1);
            categoriesList.add(postCategories[j].name);
          } else {
            categoriesHashMap.put(postCategories[j].name, categoriesHashMap.get(postCategories[j].name) + 1);
          }
          break;
        } 
     }
  }  %>
      <% for (let i = 0; i < categoriesList.size(); i++) { %>
        <% var catName = categoriesList.get(i) %>
        <li class="">
            <a href="/categories<%- url_for(catName) %>"><%= catName %></a>
            <span><i><%= categoriesHashMap.get(catName) %></i></span>
        </li>
        <% if(categoryChildHashmap.containsKey(catName)) { %>
          <% var childListOfParent = categoryChildHashmap.get(catName) %>
          <% for (let k = 0; k < childListOfParent.size(); k++) { %>
            <% var childCat = childListOfParent.get(k) %>
            <li class="category-child">
                <a href="<%- url_for(childCat.path) %>"><%= childCat.name %></a>
                <span><i><%= childCountMap.containsKey(childCat.name) ? childCountMap.get(childCat.name) : 0 %></i></span>
            </li>
          <% } %>
        <% } %>
    <% } %>
    

    
</ul>