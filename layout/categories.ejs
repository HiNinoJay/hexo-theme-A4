<br>
<span><span class="darkmode-ignore">🔖</span><i>categories</i></span>
<ul class="" >


  <% var array = eval('site.posts.data') %>

  <% var categoriesHashMap = new Map() %>
  <% var categoryChildHashmap = new Map() %>
  <% var categoriesList = [] %>
  
  <% for(var i = 0; i < array.length; i++) {
     if(!('hide' in array[i]) || array[i].hide == false){

        var postCategories = array[i].categories.data;
        for(var j = 0; j < postCategories.length; j++) {

          if(postCategories.length > 1) {
            categoryChildHashmap.set(postCategories[0].name, postCategories[1]);
          }

          if(!categoriesHashMap.has(postCategories[j].name)) {
            categoriesHashMap.set(postCategories[j].name, 1);
            categoriesList.push(postCategories[j].name);
          } else {
            categoriesHashMap.set(postCategories[j].name, categoriesHashMap.get(postCategories[j].name) + 1);
          }
          break;
        } 
     }
  }  %>
      <% for (let i = 0; i < categoriesList.length; i++) { %>
        <li class="">
            <a href="/categories<%- url_for(categoriesList[i]) %>"><%= categoriesList[i] %></a>
            <span><i><%= categoriesHashMap.get(categoriesList[i]) %></i></span>
        </li>
    <% } %>
    

    
</ul>