<br>
<span><span class="darkmode-ignore">📌</span><i>tags</i></span>
<ul class="inline-ul" >



  <% var array = eval('site.posts.data') %>

  <% var tagHashMap = new Map() %>
  <% var tagList = [] %>
  
  <% for(var i = 0; i < array.length; i++) {
     if(!('hide' in array[i]) || array[i].hide == false){
        var postTags = array[i].tags.data;
        for(var j = 0; j < postTags.length; j++) {
          if(!tagHashMap.has(postTags[j].name)) {
            tagHashMap.set(postTags[j].name, 1);
            tagList.push(postTags[j].name);
          } else {
            tagHashMap.set(postTags[j].name, tagHashMap.get(postTags[j].name) + 1);
          }
        } 
     }
  } %>
      <% for (let i = 0; i < tagList.length; i++) { %>
        <li class="inline-li">
            <a href="/tags<%- url_for(tagList[i]) %>"><%= tagList[i] %></a>
            <span><i><%= tagHashMap.get(tagList[i]) %></i></span>
        </li>
    <% } %>
    
</ul>
